# TIDAL (provide the token.json file contents as a secret value)
TOKEN_JSON=
TIDAL_FILE=
TOKEN_JSON_SECRET=
TOKEN_FILE=token.json
COUNTRY_CODE=RO
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=
USER_ID=

# Qobuz (individual values override JSON config)
QOBUZ_CONFIG_JSON=
QOBUZ_ENV_CONTENTS=
ENV_CONTENTS=
QOBUZ_EMAIL=
QOBUZ_PASSWORD=
QOBUZ_APP_ID=
QOBUZ_APP_SECRETS=

# Deezer
DEEZLOAD_ARL=

# SoundCloud
# Optional override; a working default client ID is built into the provider.
SOUNDCLOUD_CLIENT_ID=
# Optional OAuth token (do not hardcode it in source code).
SOUNDCLOUD_OAUTH_TOKEN=
SOUNDCLOUD_USER_AGENT=okhttp/5.3.2
SOUNDCLOUD_APP_VERSION=1789138724
# Optional WVD device file path. Relative paths resolve from the project root
# (the same directory as main.py). Place the file in the project before launch.
WVD=device.wvd

# Beatport — authorized OAuth client/account
BEATPORT_USERNAME=
BEATPORT_PASSWORD=
BEATPORT_API_URL=https://api.beatport.com/v4/
BEATPORT_USER_AGENT=BeatportAPI/1.0

# Runtime
DOWNLOAD_DIR=
CONFIG_DIR=
PORT=7860
CORS_ORIGINS=*

# Parallel collection downloads (1-8; default 4)
DEEZER_DOWNLOAD_CONCURRENCY=4
# Parallel SoundCloud HLS segment downloads (1-12; default 6)
SOUNDCLOUD_DOWNLOAD_CONCURRENCY=6
SOUNDCLOUD_DOWNLOAD_CONNECTIONS=12
